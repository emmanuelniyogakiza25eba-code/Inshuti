# Public browser configuration for the INSHUTI Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://vmwvwydnghwwmxcmednj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=Inshuti-media

# Server-side aliases used by the secure Next.js API routes.
SUPABASE_URL=https://vmwvwydnghwwmxcmednj.supabase.co
SUPABASE_ANON_KEY=

# Optional aliases for a CRA/Vite build. This repository currently uses Next.js.
VITE_SUPABASE_URL=https://vmwvwydnghwwmxcmednj.supabase.co
VITE_SUPABASE_ANON_KEY=
REACT_APP_SUPABASE_URL=https://vmwvwydnghwwmxcmednj.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# Server-only values for secure owner-only storage and database mutations.
# Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
INSHUTI_OWNER_PASSWORD=
INSHUTI_ADMIN_SESSION_SECRET=

# Resend email delivery (server only; set a verified sender address for production)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=INSHUTI st@re <sender@your-verified-domain.example>
NEXT_PUBLIC_SITE_URL=https://your-store-domain.example
INSHUTI_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
